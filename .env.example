TELEGRAM_TOKEN=your-telegram-bot-token

# Travelpayouts Aviasales Data API — primary flight price source (free)
# Register at: https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=your-travelpayouts-token

# Duffel API — pre-alert price verification (pay-per-verify at personal scale)
# Register at: https://app.duffel.com
DUFFEL_API_KEY=your-duffel-api-key

LOG_LEVEL=INFO

# EUR/TRY exchange rate used to normalize Pegasus (TRY) prices to EUR for threshold comparison
EUR_TRY_RATE=54.0
